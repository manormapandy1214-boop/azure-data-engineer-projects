							"collapsed": false
						},
						"source": [
							"%%sql\n",
							"CREATE TABLE IF NOT EXISTS dim_customer_scd1 (\n",
							"    CustomerID   INT,\n",
							"    CustomerName STRING,\n",
							"    City         STRING\n",
							")\n",
							"USING DELTA;"
						],
						"outputs": [],
						"execution_count": 12
					},
					{
						"cell_type": "code",
						"metadata": {
							"microsoft": {
								"language": "sparksql"
							},
							"collapsed": false
						},
						"source": [
							"%%sql\n",
							"INSERT INTO dim_customer_scd1 VALUES\n",
							"(101, 'Amit',  'Pune'),\n",
							"(102, 'Neha',  'Mumbai'),\n",
							"(103, 'Rahul', 'Delhi');"
						],
						"outputs": [],
						"execution_count": 13
					},
					{
						"cell_type": "code",
						"metadata": {
							"microsoft": {
								"language": "sparksql"
							},
							"collapsed": false
						},
						"source": [
							"%%sql\n",
							"CREATE OR REPLACE TEMP VIEW source_customer AS\n",
							"SELECT 101 AS CustomerID, 'Amit'  AS CustomerName, 'Bangalore' AS City\n",
							"UNION ALL\n",
							"SELECT 104, 'Priya', 'Chennai';"
						],
						"outputs": [],
						"execution_count": 14
					},
					{
						"cell_type": "code",
						"metadata": {
							"microsoft": {
								"language": "sparksql"
							},
							"collapsed": false
						},
						"source": [
							"%%sql\n",
							"MERGE INTO dim_customer_scd1 AS tgt\n",
							"USING source_customer AS src\n",
							"ON tgt.CustomerID = src.CustomerID\n",
							"\n",
							"WHEN MATCHED AND (tgt.CustomerName <> src.CustomerName OR tgt.City <> src.City)\n",
							"THEN UPDATE SET\n",
							"    tgt.CustomerName = src.CustomerName,\n",
							"    tgt.City         = src.City\n",
							"\n",
							"WHEN NOT MATCHED THEN INSERT (CustomerID, CustomerName, City)\n",
							"VALUES (src.CustomerID, src.CustomerName, src.City);"
						],
						"outputs": [],
						"execution_count": 15
					},
