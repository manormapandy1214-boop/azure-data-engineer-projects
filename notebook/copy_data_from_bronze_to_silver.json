		"cells": [
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"from pyspark.sql import functions as F\n",
					"from pyspark.sql.window import Window\n",
					"from delta.tables import DeltaTable\n",
					"\n",
					"\n",
					"storage_account = \"synapase\"\n",
					"\n",
					"container = \"synapse-filename\"\n",
					"\n",
					"bronze = (\n",
					"    f\"abfss://synapse-filename@synapase.dfs.core.windows.net/Bronze\"\n",
					")\n",
					"\n",
					"silver = (\n",
					"    f\"abfss://synapse-filename@synapase.dfs.core.windows.net/Silver\"\n",
					")\n",
					"\n",
					"gold = (\n",
					"    f\"abfss://synapse-filename@synapase.dfs.core.windows.net/Gold\"\n",
					")\n",
					"\n",
					"# Read Dimension Parquet file\n",
					"dim_raw = spark.read.parquet(\n",
					"    bronze + \"/Dim_Dealer.parquet\"\n",
					")\n",
					"\n",
					"# Read Fact Parquet file\n",
					"fact_raw = spark.read.parquet(\n",
					"    bronze + \"/Fact_Mobility_Demand.parquet\"\n",
					")\n",
					"\n",
					"print(\"Dimension records:\", dim_raw.count())\n",
					"print(\"Fact records:\", fact_raw.count())\n",
					"\n",
					"display(dim_raw)\n",
					"display(fact_raw)"
				],
				"execution_count": 34
			},
			{
				"cell_type": "code",
				"source": [
					"\"\"\"cleaning data in silver layer\"\"\"\n",
					"dim_raw.printSchema()\n",
					"fact_raw.printSchema()"
				],
				"execution_count": 35
			},
			{
				"cell_type": "code",
				"source": [
					"\"\"\"Remove duplicates\"\"\"\n",
					"dim_silver=dim_raw.drop_duplicates([\"dealer_id\"])\n",
					"\n",
					"dim_Silver=dim_silver.filter(F.col(\"dealer_id\").isNotNull())"
				],
				"execution_count": 36
			},
			{
				"cell_type": "code",
				"source": [
					"\"\"\"trim space\"\"\"\n",
					"string_cols=[\n",
					"    \"dealer_id\",\n",
					"    \"dealer_name\",\n",
					"    \"city\",\n",
					"    \"pipeline_type\",\n",
					"    \"source_system\",\n",
					"    \"target_system\",\n",
					"    \"migration_status\"\n",
					"]\n",
					"\n",
					"for c in string_cols:\n",
					"    dim_Silver=dim_silver.withColumn(c,F.trim(F.col(c)))\n",
					"\n",
					""
				],
				"execution_count": 37
			},
			{
				"cell_type": "code",
				"source": [
					"\"\"\"Standardize Text\"\"\"\n",
					"dim_silver=(dim_silver\n",
					"   .withColumn(\"city\",F.initcap(\"city\"))\n",
					"   .withColumn(\"state\", F.initcap(\"state\"))\n",
					"    .withColumn(\"migration_status\", F.initcap(\"migration_status\"))\n",
					")"
				],
				"execution_count": 38
			},
			{
				"cell_type": "code",
				"source": [
					"dim_silver = dim_silver.withColumn(\n",
					"    \"updated_at\",\n",
					"    F.to_timestamp(\n",
					"        \"updated_at\",\n",
					"        \"M/d/yyyy H:mm\"\n",
					"    )\n",
					")"
				],
				"execution_count": 39
			},
			{
				"cell_type": "code",
				"source": [
					"\"\"\"6. Add Audit Columns\"\"\"\n",
					"\n",
					"dim_silver = (\n",
					"    dim_silver\n",
					"    .withColumn(\"load_date\", F.current_timestamp())\n",
					"    .withColumn(\"source_layer\", F.lit(\"Silver\"))\n",
					")\n",
					""
				],
				"execution_count": 40
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"\"\"\"validate\"\"\"\n",
					"print(\"silver count:\",dim_Silver.count())\n",
					"display(dim_Silver)"
				],
				"execution_count": 41
			},
			{
				"cell_type": "code",
				"source": [
					"\"\"\"write data in silver layer\"\"\"\n",
					"dim_silver.write.mode(\"overwrite\")\\\n",
					".parquet(silver+\"/dim_dealer\")"
				],
				"execution_count": 42
			},
			{
				"cell_type": "code",
				"source": [
					"dim_gold = (\n",
					"    dim_silver\n",
					"    .withColumn(\"start_date\",F.current_date())\n",
					"    .withColumn(\"end_date\",F.lit(\"9999-12-31\"))\n",
					"    .withColumn(\"is_current\",F.lit(1))\n",
					")\n",
					"\n",
					"dim_gold.write \\\n",
					".format(\"delta\") \\\n",
					".mode(\"overwrite\") \\\n",
					".save(\n",
					"gold + \"/DimDealer\"\n",
					")"
				],
				"execution_count": 43
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"from pyspark.sql import functions as F\n",
					"\n",
					"dim_silver = (\n",
					"    dim_raw\n",
					"    .dropDuplicates([\"dealer_id\"])\n",
					"    .filter(F.col(\"dealer_id\").isNotNull())\n",
					")\n",
					"\n",
					"dim_silver = dim_silver.withColumn(\n",
					"    \"updated_at\",\n",
					"    F.to_timestamp(\n",
					"        F.col(\"updated_at\"),\n",
					"        \"M/d/yyyy H:mm\"\n",
					"    )\n",
					")\n",
					"\n",
					"display(dim_silver)\n",
					""
				],
				"execution_count": 44
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"gold_dim = spark.read.format(\"delta\").load(\n",
					"    gold + \"/DimDealer\"\n",
					")\n",
					"\n",
					"display(gold_dim)"
				],
				"execution_count": 45
			},
			{
				"cell_type": "code",
				"source": [
					"\"\"\"gold fact tale\"\"\"\n",
					"\n",
					"fact_gold = fact_silver.select(\n",
					"\"demand_id\",\n",
					"\"dealer_id\",\n",
					"\"material_id\",\n",
					"\"demand_month\",\n",
					"\"demand_type\",\n",
					"\"demand_qty\",\n",
					"\"allocated_qty\",\n",
					"\"shipped_qty\",\n",
					"\"pipeline_type\",\n",
					"\"migration_batch_id\"\n",
					")"
				],
				"execution_count": 46
			},
			{
				"cell_type": "code",
				"source": [
					"fact_gold.write \\\n",
					".format(\"delta\") \\\n",
					".mode(\"overwrite\") \\\n",
					".save(\n",
					"gold + \"/FactMobilityDemand\"\n",
					")"
				],
				"execution_count": 47
			},
			{
				"cell_type": "code",
				"source": [
					"fact_gold = fact_silver.select(\n",
					"\"demand_id\",\n",
					"\"dealer_id\",\n",
					"\"material_id\",\n",
					"\"demand_month\",\n",
					"\"demand_type\",\n",
					"\"demand_qty\",\n",
					"\"allocated_qty\",\n",
					"\"shipped_qty\",\n",
					"\"pipeline_type\",\n",
					"\"migration_batch_id\"\n",
					")"
				],
				"execution_count": 48
			}
		]
	}
