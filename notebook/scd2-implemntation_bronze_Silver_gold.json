				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"\"\"\"raed bronze layer\"\"\"\n",
					"bronze_df=spark.read.parquet(bronze_path)\n",
					"display(bronze_df)"
				],
				"execution_count": 4
			},
			{
				"cell_type": "code",
				"source": [
					"\"\"\"save data in silver andcarete delta tabel\"\"\"\n",
					"silver_df=bronze_df.drop_duplicates([\"customer_id\"])\n",
					"silver_path=\"abfss://synapse-filename@synapase.dfs.core.windows.net/silver/customer\"\n",
					"silver_df.write \\\n",
					".format(\"Delta\")\\\n",
					".mode(\"overwrite\") \\\n",
					".save(silver_path)"
				],
				"execution_count": 5
			}
		]
