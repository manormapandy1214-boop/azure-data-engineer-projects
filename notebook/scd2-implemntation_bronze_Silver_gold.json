				"source": [
					"\"\"\"read data in adlsgen2 container\"\"\"\n",
					"source_path = \"abfss://synapse-filename@synapase.dfs.core.windows.net/input/Customer.csv\"\n",
					"\n",
					"df = spark.read \\\n",
					"    .option(\"header\", \"true\") \\\n",
					"    .csv(source_path)\n",
					"\n",
					"display(df)"
				],
				"execution_count": 2
			},
			{
				"cell_type": "code",
				"source": [
					"\"\"\"save data inbronze layer\"\"\"\n",
					"bronze_path=\"abfss://synapse-filename@synapase.dfs.core.windows.net/bronze/customer\"\n",
					"df.write \\\n",
					".mode(\"overwrite\") \\\n",
					".parquet(bronze_path)"
