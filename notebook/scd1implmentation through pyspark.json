		"cells": [
			{
				"cell_type": "code",
				"source": [
					"from pyspark.sql import functions as F\n",
					"\n",
					"target_data=[(\"1\",\"manu\",\"pune\"),\n",
					"(\"2\",\"nitesh\",\"banglore\"),\n",
					"(\"3\",\"micky\",\"punjab\")\n",
					"]\n",
					"\n",
					"columns=[\"dealer_id\",\"name\",\"city\"]\n",
					"target_df=spark.createDataFrame(target_data,columns)\n",
					"target_df.show()"
				],
				"execution_count": 23
			},
			{
				"cell_type": "code",
				"source": [
					"\"\"\"craete source data\"\"\"\n",
					"source_data=[(\"1\",\"manu\",\"nagpur\"),\n",
					"(\"4\",\"yaskshit\",\"kannda\")]\n",
					"\n",
					"source_data=spark.createDataFrame(source_data,columns)\n",
					"\n",
					"source_data.show()"
				],
				"execution_count": 24
			},
			{
				"cell_type": "code",
				"source": [
					"\"\"\"save target data in a delta table\"\"\"\n",
					"target_df.write \\\n",
					".format(\"delta\")\\\n",
					".mode(\"overwrite\")\\\n",
					".saveAsTable(\"dim_dealer\")"
				],
				"execution_count": 25
			},
			{
				"cell_type": "code",
				"source": [
					"from delta.tables import DeltaTable\n",
					"\n",
					"target_df.write.format(\"delta\").mode(\"overwrite\").saveAsTable(\"Dim_Dealer\")\n",
					"\n",
					"target_table = DeltaTable.forName(spark, \"Dim_Dealer\")\n",
					"\n",
					"(\n",
					"    target_table.alias(\"T\")\n",
					"    .merge(\n",
					"        source_data.alias(\"S\"),\n",
					"        \"T.dealer_id = S.dealer_id\"\n",
					"    )\n",
					"    .whenMatchedUpdate(set={\n",
					"        \"name\": \"S.name\",\n",
					"        \"city\": \"S.city\"\n",
					"    })\n",
					"    .whenNotMatchedInsert(values={\n",
					"        \"dealer_id\": \"S.dealer_id\",\n",
					"        \"name\": \"S.name\",\n",
					"        \"city\": \"S.city\"\n",
					"    })\n",
					"    .execute()\n",
					")\n",
					"\n",
					"spark.table(\"Dim_Dealer\").show()"
				],
				"execution_count": 27
			},
			{
				"cell_type": "code",
				"source": [
					"spark.read.table(\"dim_dealer\").orderBy(\"dealer_id\").show()"
				],
				"execution_count": 28
			}
		]
	}
