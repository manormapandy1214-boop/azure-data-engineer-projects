					"collapsed": false
				},
				"source": [
					"%%sql\n",
					"CREATE TABLE IF NOT EXISTS dim_customer_scd1 (\n",
					"    CustomerID   INT,\n",
					"    CustomerName STRING,\n",
					"    City         STRING\n",
					")\n",
					"USING DELTA;"
				],
				"execution_count": 12
			},
			{
				"cell_type": "code",
				"metadata": {
					"microsoft": {
						"language": "sparksql"
					},
					"collapsed": false
				},
				"source": [
					"%%sql\n",
					"INSERT INTO dim_customer_scd1 VALUES\n",
					"(101, 'Amit',  'Pune'),\n",
					"(102, 'Neha',  'Mumbai'),\n",
					"(103, 'Rahul', 'Delhi');"
				],
				"execution_count": 13
			},
			{
				"cell_type": "code",
				"metadata": {
					"microsoft": {
						"language": "sparksql"
					},
					"collapsed": false
				},
				"source": [
					"%%sql\n",
					"CREATE OR REPLACE TEMP VIEW source_customer AS\n",
					"SELECT 101 AS CustomerID, 'Amit'  AS CustomerName, 'Bangalore' AS City\n",
					"UNION ALL\n",
					"SELECT 104, 'Priya', 'Chennai';"
				],
				"execution_count": 14
			},
			{
				"cell_type": "code",
				"metadata": {
					"microsoft": {
						"language": "sparksql"
					},
					"collapsed": false
				},
				"source": [
					"%%sql\n",
					"MERGE INTO dim_customer_scd1 AS tgt\n",
					"USING source_customer AS src\n",
					"ON tgt.CustomerID = src.CustomerID\n",
					"\n",
					"WHEN MATCHED AND (tgt.CustomerName <> src.CustomerName OR tgt.City <> src.City)\n",
					"THEN UPDATE SET\n",
					"    tgt.CustomerName = src.CustomerName,\n",
					"    tgt.City         = src.City\n",
					"\n",
					"WHEN NOT MATCHED THEN INSERT (CustomerID, CustomerName, City)\n",
					"VALUES (src.CustomerID, src.CustomerName, src.City);"
				],
				"execution_count": 15
			},
			{
				"cell_type": "code",
				"metadata": {
					"microsoft": {
						"language": "sparksql"
					},
					"collapsed": false
				},
				"source": [
					"%%sql\n",
					"SELECT * FROM dim_customer_scd1 ORDER BY CustomerID;"
				],
				"execution_count": 17
			},
			{
				"cell_type": "code",
				"metadata": {
					"microsoft": {
						"language": "python"
					}
				},
				"source": [
					"%%pyspark\n",
					"import com.microsoft.spark.sqlanalytics\n",
					"from com.microsoft.spark.sqlanalytics.Constants import Constants\n",
					"\n",
					"df = spark.table(\"dim_customer_scd1\")\n",
					"\n",
					"df.write \\\n",
					"  .mode(\"overwrite\") \\\n",
					"  .synapsesql(\"sql_pool.dw.DimCustomer_SCD1\")"
				],
				"execution_count": 24
			},
			{
				"cell_type": "code",
				"metadata": {
					"microsoft": {
						"language": "python"
					}
				},
